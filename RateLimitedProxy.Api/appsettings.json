{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",

  "Upstream": {
    "BaseUrl": "https://api.example.com/",
    "TimeoutMs": 5000,
    "MaxConcurrency": 20
  },

  "RateLimit": {
    "Capacity": 10,
    "RefillPerSecond": 1.0
  }
}
